{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Belvedir",
  "appearance": {
    "default": "light"
  },
  "colors": {
    "primary": "#040404",
    "light": "#EDEDED",
    "dark": "#040404"
  },
  "logo": {
    "light": "/logo/belvedir-lockup.svg",
    "dark": "/logo/belvedir-lockup-dark.svg"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "sdk/python",
              "how-it-works"
            ]
          },
          {
            "group": "Node SDK",
            "pages": [
              "sdk/installation",
              "sdk/configuration",
              "sdk/supported-providers"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/nextjs",
              "guides/ai-sdk",
              "guides/custom-agent-loops",
              "guides/background-workers",
              "guides/otel-agents",
              "importing-traces"
            ]
          },
          {
            "group": "Inference",
            "pages": [
              "inference/route-your-calls",
              "inference/models",
              "inference/mixture-of-models",
              "inference/capabilities",
              "inference/playground",
              "inference/hosted",
              "inference/local-models"
            ]
          },
          {
            "group": "Training",
            "pages": [
              "training/optimization-loops",
              "training/overview"
            ]
          },
          {
            "group": "Benchmarks",
            "pages": [
              "benchmarks/overview",
              "benchmarks/environments",
              "benchmarks/harbor"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "cli",
              "data-handling",
              "troubleshooting/common-issues",
              "migrating-from-fractal"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview",
              "api-reference/authentication"
            ]
          },
          {
            "group": "Tracing",
            "pages": [
              "api-reference/traces",
              "api-reference/outcomes"
            ]
          },
          {
            "group": "Inference",
            "pages": [
              "api-reference/chat-completions",
              "api-reference/messages",
              "api-reference/embeddings",
              "api-reference/batches",
              "api-reference/route"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "belvedir.ai",
        "href": "https://belvedir.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://platform.belvedir.ai"
    }
  },
  "redirects": [
    {
      "source": "/troubleshooting/faq",
      "destination": "/troubleshooting/common-issues"
    },
    {
      "source": "/guides/vercel",
      "destination": "/guides/nextjs"
    },
    {
      "source": "/guides/vercel-ai-gateway",
      "destination": "/guides/ai-sdk"
    },
    {
      "source": "/guides/environment-variables",
      "destination": "/sdk/configuration"
    }
  ]
}
